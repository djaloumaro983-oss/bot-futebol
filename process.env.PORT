const express = require('express');
const axios = require('axios');

const { WHATSAPP_TOKEN, PHONE_NUMBER_ID, VERIFY_TOKEN, API_FOOTBALL_KEY } = process.env;
const PORT = process.env.PORT || 3000;
const POLL_MS = Number(process.env.POLL_MS || 60000);
const LIGAS = (process.env.LIGAS || '71,73,13,11,2,39,140').split(',').map(Number);

const futebol = axios.create({
  baseURL: 'https://v3.football.api-sports.io',
  headers: { 'x-apisports-key': API_FOOTBALL_KEY },
});

const assinantes = new Set();
const placar = new Map();

const linha = (f) =>
  `${f.teams.home.name} ${f.goals.home ?? 0} x ${f.goals.away ?? 0} ${f.teams.away.name}`;

async function aoVivo() {
  const { data } = await futebol.get('/fixtures', { params: { live: 'all' } });
  return data.response.filter((f) => LIGAS.includes(f.league.id));
}

async function jogosHoje() {
  const date = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
  const { data } = await futebol.get('/fixtures', {
    params: { date, timezone: 'America/Sao_Paulo' },
  });
  return data.response.filter((f) => LIGAS.includes(f.league.id));
}

async function enviar(para, texto) {
  try {
    await axios.post(
      `https://graph.facebook.com/v21.0/${PHONE_NUMBER_ID}/messages`,
      { messaging_product: 'whatsapp', to: para, type: 'text', text: { body: texto } },
      { headers: { Authorization: `Bearer ${WHATSAPP_TOKEN}` } }
    );
  } catch (e) {
    console.error('Erro ao enviar:', e.response?.data || e.message);
  }
}

async function responder(de, texto) {
  const txt = texto.trim().toLowerCase();
  try {
    if (txt === '!ajuda' || txt === 'oi' || txt === 'menu') {
      return enviar(
        de,
        '⚽ *Comandos*\n!aovivo – jogos rolando\n!hoje – jogos de hoje\n!time <nome> – busca um time\n!alertas on/off – avisos de gol'
      );
    }

    if (txt === '!aovivo') {
      const jogos = await aoVivo();
      return enviar(
        de,
        jogos.length
          ? jogos.map((f) => `🔴 ${linha(f)} (${f.fixture.status.elapsed}')`).join('\n')
          : 'Nenhum jogo ao vivo agora.'
      );
    }

    if (txt === '!hoje') {
      const jogos = await jogosHoje();
      return enviar(
        de,
        jogos.length
          ? jogos
              .map((f) => {
                const hora = new Date(f.fixture.date).toLocaleTimeString('pt-BR', {
                  hour: '2-digit', minute: '2-digit', timeZone: 'America/Sao_Paulo',
                });
                return `🕒 ${hora} – ${linha(f)} [${f.fixture.status.short}]`;
              })
              .join('\n')
          : 'Sem jogos hoje nas ligas configuradas.'
      );
    }

    if (txt.startsWith('!time ')) {
      const nome = txt.slice(6).trim();
      const jogos = (await jogosHoje()).filter((f) =>
        `${f.teams.home.name} ${f.teams.away.name}`.toLowerCase().includes(nome)
      );
      return enviar(
        de,
        jogos.length
          ? jogos.map((f) => `${linha(f)} [${f.fixture.status.long}]`).join('\n')
          : `Nada hoje para "${nome}".`
      );
    }

    if (txt === '!alertas on') {
      assinantes.add(de);
      return enviar(de, '🔔 Alertas de gol ligados!');
    }
    if (txt === '!alertas off') {
      assinantes.delete(de);
      return enviar(de, '🔕 Alertas desligados.');
    }
  } catch (e) {
    console.error(e.message);
    enviar(de, 'Deu erro ao buscar os dados. Tenta de novo já já.');
  }
}

const app = express();
app.use(express.json());

app.get('/webhook', (req, res) => {
  if (
    req.query['hub.mode'] === 'subscribe' &&
    req.query['hub.verify_token'] === VERIFY_TOKEN
  ) {
    return res.status(200).send(req.query['hub.challenge']);
  }
  res.sendStatus(403);
});

app.post('/webhook', (req, res) => {
  res.sendStatus(200);
  const msgs = req.body.entry?.[0]?.changes?.[0]?.value?.messages || [];
  for (const m of msgs) {
    if (m.type === 'text') responder(m.from, m.text.body);
  }
});

setInterval(async () => {
  if (!assinantes.size) return;
  try {
    for (const f of await aoVivo()) {
      const total = (f.goals.home ?? 0) + (f.goals.away ?? 0);
      const antes = placar.get(f.fixture.id);
      placar.set(f.fixture.id, total);
      if (antes !== undefined && total > antes) {
        const aviso = `⚽ *GOOOL!* ${linha(f)} (${f.fixture.status.elapsed}')`;
        for (const n of assinantes) enviar(n, aviso);
      }
    }
  } catch (e) {
    console.error('Erro no polling:', e.message);
  }
}, POLL_MS);

app.listen(PORT, () => console.log(`Bot online na porta ${PORT} ⚽`));const express = require('express');
